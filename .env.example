# ==============================================
# Server Configuration
# ==============================================
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
WORKERS=1

# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL=sqlite:///pcb_defects.db
# PostgreSQL example: DATABASE_URL=postgresql://user:password@localhost:5432/defectnet
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==============================================
# JWT / Auth Configuration
# ==============================================
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================
# Model Configuration
# ==============================================
MODEL_PATH=src/models/best.pt
DEFAULT_CONFIDENCE=0.25
IMAGE_SIZE=1024
IOU_THRESHOLD=0.45
AUGMENT=True

# ==============================================
# Storage Paths
# ==============================================
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
RESULTS_DIR=storage/results
REPORTS_DIR=storage/reports
EXPORTS_DIR=storage/exports

# ==============================================
# File Upload Limits
# ==============================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ==============================================
# CORS Configuration
# ==============================================
ALLOWED_ORIGINS=*

# ==============================================
# API Security
# ==============================================
RATE_LIMIT_PER_MINUTE=100

# ==============================================
# Redis / Celery Configuration
# ==============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=UTC

# ==============================================
# Batch Processing Limits
# ==============================================
MAX_BATCH_SIZE=20
MAX_PARALLEL_TASKS=10
TASK_TIME_LIMIT=300

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=INFO
LOG_FORMAT=text
